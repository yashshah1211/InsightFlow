# Generate data/processed/official.json before choosing official. Explicit production mode required.
INSIGHTFLOW_DATA_MODE=official
# Optional safe public preview: synthetic-preview requires fixture mode and writes=false.
# Leave unset for official artifacts or authenticated workspaces.
# The dedicated hosted development demo uses authenticated-preview: fixture data,
# the guarded development Supabase project and its dedicated HTTPS APP_ORIGIN.
# Writes are gated per deployment; do not copy local secrets into provider settings.
INSIGHTFLOW_DEPLOYMENT_PROFILE=
# Server-only cookie-aware Supabase client; publishable key or legacy anon key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Adapter does not use a service role. Reserve this only for approved offline admin work.
SUPABASE_SERVICE_ROLE_KEY=
INSIGHTFLOW_WRITES_ENABLED=false
# Exact deployment origin. Required for production sign-in/out and before enabling writes.
APP_ORIGIN=
# Local pilot only. Offline commands ignore this; provider commands require separate hash approval.
# Local Python: explicit --secrets-file .env.local loads only this key; use ignored .venv SDK.
# Do not add this key to browser code or Vercel.
ADAPTION_API_KEY=
# Optional authorized development acceptance only; put real values in ignored .env.local.
# Never deploy these test-account credentials or the read-only preflight management token.
LIVE_TEST_USER_A_EMAIL=
LIVE_TEST_USER_A_PASSWORD=
LIVE_TEST_USER_B_EMAIL=
LIVE_TEST_USER_B_PASSWORD=
