{
  "name": "insightflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build-readiness.ts && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m unittest discover -s scripts/adaption -p test_*.py",
    "security": "tsx scripts/security-check.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "data:inspect": "tsx scripts/inspect-csv.ts",
    "data:prepare": "tsx scripts/prepare-official.ts",
    "adaption:prepare": "python scripts/adaption/pipeline.py prepare",
    "adaption:review": "python scripts/adaption/review.py",
    "adaption:upload": "python scripts/adaption/pipeline.py upload",
    "adaption:estimate": "python scripts/adaption/pipeline.py estimate",
    "adaption:execute": "python scripts/adaption/pipeline.py execute",
    "adaption:download": "python scripts/adaption/pipeline.py download",
    "adaption:validate": "python scripts/adaption/pipeline.py validate",
    "adaption:curate": "tsx scripts/curate-adaption.ts",
    "package:verify": "tsx scripts/verify-production-package.ts",
    "contracts:examples": "node --conditions=react-server --import tsx scripts/contract-examples.ts",
    "smoke": "tsx scripts/smoke.ts",
    "preview:verify": "tsx scripts/verify-preview-package.ts",
    "smoke:preview": "tsx scripts/preview-smoke.ts",
    "smoke:integration": "tsx scripts/integration-smoke.ts",
    "smoke:auth": "tsx scripts/auth-smoke.ts",
    "smoke:live": "node --import tsx scripts/live-supabase.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "csv-parse": "7.0.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "unicode-case-folding": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
